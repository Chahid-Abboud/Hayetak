APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PLANNER_OLLAMA_ONLY=true
AI_PLANNER_PROVIDER=ollama
AI_PLANNER_PROMPT_VERSION=hayetak_planner_v2
AI_PLANNER_SCHEMA_VERSION=hayetak_plan_v2
AI_PLANNER_DEFAULT_HORIZON_DAYS=14
OPENAI_MODEL_PLANNER=gpt-4.1-mini
OPENAI_MODEL_COACH=gpt-4.1-mini
AI_PLANNER_OLLAMA_URL=http://127.0.0.1:11434
AI_PLANNER_OLLAMA_MODEL=llama3.1:8b
AI_PLANNER_OLLAMA_CONNECT_TIMEOUT=4
AI_PLANNER_OLLAMA_TIMEOUT=120
AI_PLANNER_REQUEST_TIMEOUT=300
AI_PLANNER_OLLAMA_TEMPERATURE=0.1
AI_PLANNER_OLLAMA_MAX_OUTPUT_TOKENS=700
AI_PLANNER_FALLBACK_TO_OPENAI=false
AI_PLANNER_LOCAL_FALLBACK_ENABLED=false
OPENAI_TIMEOUT=60
AI_CHAT_PROVIDER=stub
AI_CHAT_ENDPOINT=
AI_CHAT_TOKEN=
AI_CHAT_HTTP_TIMEOUT=30
AI_SELF_HOSTED_OLLAMA_URL=http://127.0.0.1:11434
AI_SELF_HOSTED_LLM_MODEL=llama3.1:8b
AI_SELF_HOSTED_EMBED_MODEL=nomic-embed-text
AI_SELF_HOSTED_OLLAMA_CONNECT_TIMEOUT=4
AI_SELF_HOSTED_LLM_TIMEOUT=120
AI_SELF_HOSTED_EMBED_TIMEOUT=60
AI_SELF_HOSTED_TEMPERATURE=0.2
AI_SELF_HOSTED_QDRANT_URL=http://127.0.0.1:6333
AI_SELF_HOSTED_QDRANT_COLLECTION=hayetak_user_context
AI_SELF_HOSTED_QDRANT_TIMEOUT=20
AI_SELF_HOSTED_QDRANT_DISTANCE=Cosine
AI_SELF_HOSTED_CONTEXT_THRESHOLD=0.65
AI_SELF_HOSTED_CONTEXT_LIMIT=4
AI_SELF_HOSTED_MAX_CONTEXT_CHARS=2200
AI_SELF_HOSTED_SYNC_DURING_TESTS=false
AI_PLANNER_MAX_OUTPUT_TOKENS=3200
AI_PLAN_RATE_LIMIT=3,1
AI_CHAT_RATE_LIMIT=20,1
AI_CONTEXT_CACHE_TTL=300
AI_USAGE_LOG_ENABLED=true
AI_PROGRESS_PREDICTOR_INFERENCE_ENABLED=true
AI_PROGRESS_PREDICTOR_MODEL_DIR=storage/app/ai/models/progress_predictor_v1_real_only
AI_PROGRESS_PREDICTOR_GUARDRAILS_ENABLED=true
AI_PROGRESS_PREDICTOR_MIN_CONFIDENCE_FOR_ML=medium
AI_PROGRESS_PREDICTOR_REQUIRE_MACRO_TARGETS=true
AI_PROGRESS_PREDICTOR_MIN_MEAL_LOGGED_DAYS=0
AI_PROGRESS_PREDICTOR_MIN_WORKOUT_SESSIONS=0
AI_PROGRESS_PREDICTOR_MAX_WEEKLY_DELTA_GAP_KG=0.8
AI_PROGRESS_PREDICTOR_MAX_ABS_WEEKLY_RATE_KG=1.2

VITE_APP_NAME="${APP_NAME}"
